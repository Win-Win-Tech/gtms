########################################
# MediaMTX — GTMS CCTV live view (Phase 2)
# Docs: https://github.com/bluenviron/mediamtx
#
# Live playback prefers WebRTC (WHEP :8889) for low latency; HLS (:8888) is fallback.
#
# On a public server, set webrtcAdditionalHosts to the public IP/hostname and open:
#   TCP 8888 (HLS), TCP 8889 (WebRTC signaling), UDP 8189 (ICE)
#
# Django env:
#   MEDIAMTX_API_URL=http://127.0.0.1:9997
#   MEDIAMTX_HLS_BASE_URL=http://YOUR_PUBLIC_IP:8888
#   MEDIAMTX_WEBRTC_BASE_URL=http://YOUR_PUBLIC_IP:8889
########################################

api: yes
apiAddress: :9997

hls: yes
hlsAddress: :8888
hlsAllowOrigin: '*'
hlsVariant: lowLatency
hlsSegmentCount: 7
hlsSegmentDuration: 1s
hlsPartDuration: 200ms
hlsSegmentMaxSize: 50M

webrtc: yes
webrtcAddress: :8889
webrtcAllowOrigin: '*'
webrtcAdditionalHosts: []
webrtcIPsFromInterfaces: yes
webrtcLocalUDPAddress: :8189

rtsp: yes
rtspAddress: :8554
rtpAddress: :8002
rtcpAddress: :8003

pathDefaults:
  rtspTransport: tcp
  record: no

paths: {}
